---
import "../styles/globals.css";
import BootSequence from "../components/BootSequence.astro";
import StatusHeader from "../components/StatusHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  /** Set to false on pages that should not show the boot overlay (e.g. 404). */
  showBoot?: boolean;
}

const {
  title = "ESTEBAN DIACZUNN — CODENAME: NAIKI",
  description = "Backend Developer / Software Architect-in-training. Operative profile.",
  showBoot = true,
} = Astro.props;

const siteUrl = import.meta.env.SITE;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="NAIKI — cv-land" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-bg-void text-text-primary font-sans antialiased min-h-screen flex flex-col">
    {showBoot && <BootSequence />}
    <StatusHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
