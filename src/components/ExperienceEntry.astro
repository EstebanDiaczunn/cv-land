---
import Pill from './Pill.astro';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  company: string;
  role: string;
  remote?: boolean;
  start: string;
  end: string;
  stack?: string[];
}
const { locale, company, role, remote, start, end, stack = [] } = Astro.props;
const t = ui[locale];
const period = `${start} — ${end}`;
---
<article class="group relative -mx-3 rounded-lg px-3 py-3 transition-colors hover:bg-white/[0.02]">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <div class="flex items-center gap-2">
      <h3 class="text-[14px] font-semibold text-[var(--color-text)]">{company}</h3>
      {remote && <Pill variant="success">{t.chips.remote}</Pill>}
    </div>
    <span class="font-mono text-[11px] text-[var(--color-text-muted)]">{period}</span>
  </div>
  <p class="mt-0.5 font-mono text-[12px] text-[var(--color-text-dim)]">{role}</p>
  <div class="mt-2 font-mono-tight text-[var(--color-text-dim)] [&_ul]:list-none [&_ul]:space-y-1.5 [&_li]:relative [&_li]:pl-4 [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[0.6em] [&_li]:before:h-px [&_li]:before:w-2 [&_li]:before:bg-[var(--color-border-strong)]">
    <slot />
  </div>
  {stack.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1">
      {stack.map((s) => <Pill variant="subtle">{s}</Pill>)}
    </div>
  )}
</article>
