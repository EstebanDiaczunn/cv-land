---
interface Props {
  name: string;
  syncRate: number;
  years?: number;
  yearsLabel?: string;
}

const { name, syncRate, years, yearsLabel = "YRS" } = Astro.props;
const clamped = Math.max(0, Math.min(100, syncRate));
---

<div class="sync" role="group" aria-label={`${name}: ${clamped}%`}>
  <div class="sync-meta">
    <span class="sync-name">{name}</span>
    <span class="sync-readout">
      <span class="sync-rate">{clamped}<span class="sync-unit">%</span></span>
      {years !== undefined && (
        <span class="sync-years">{years}{yearsLabel ? ` ${yearsLabel}` : ""}</span>
      )}
    </span>
  </div>
  <div class="sync-track" aria-hidden="true">
    <div class="sync-fill" style={`--sync-rate: ${clamped}%;`}></div>
    <div class="sync-ticks"></div>
  </div>
</div>

<style>
  .sync {
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-mono);
  }

  .sync-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sync-name {
    color: var(--text-secondary);
    flex: 1;
    min-width: 0;
  }

  .sync-readout {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--text-amber);
    flex-shrink: 0;
  }

  .sync-rate {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .sync-unit {
    font-size: 0.75em;
    margin-left: 0.1em;
    color: var(--accent-amber-soft);
  }

  .sync-years {
    color: var(--text-muted);
    font-size: 0.85em;
  }

  .sync-track {
    position: relative;
    height: 8px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .sync-fill {
    height: 100%;
    width: var(--sync-rate);
    background: linear-gradient(
      90deg,
      var(--accent-amber-soft) 0%,
      var(--accent-amber) 70%,
      var(--accent-amber-glow) 100%
    );
    box-shadow: 0 0 8px var(--accent-amber-glow);
    transition: width 600ms var(--ease-out);
  }

  .sync-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent calc(10% - 1px),
      rgba(10, 10, 10, 0.45) calc(10% - 1px),
      rgba(10, 10, 10, 0.45) 10%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .sync-fill {
      transition: none;
    }
  }
</style>
