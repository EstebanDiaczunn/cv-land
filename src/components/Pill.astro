---
interface Props {
  variant?: 'default' | 'subtle' | 'success' | 'success-solid';
  as?: 'span' | 'a';
  href?: string;
}
const { variant = 'default', as = 'span', href } = Astro.props;
const Tag = as;
const base =
  'inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 font-mono text-[11px] leading-5 tracking-tight transition-all duration-150';
const variants = {
  default:
    'bg-[var(--color-bg-chip)] text-[var(--color-text-dim)] border border-[var(--color-border)] hover:bg-[var(--color-bg-chip-hover)] hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)]',
  subtle:
    'bg-transparent text-[var(--color-text-muted)] border border-[var(--color-border)] hover:text-[var(--color-text-dim)] hover:border-[var(--color-border-strong)]',
  success:
    'bg-[color-mix(in_srgb,var(--color-success)_8%,transparent)] text-[var(--color-success)] border border-[color-mix(in_srgb,var(--color-success)_25%,transparent)]',
  'success-solid':
    'bg-transparent text-[var(--color-success)] border-0 px-1 text-[7px]',
};
---
<Tag class={`${base} ${variants[variant]}`} href={href}>
  <slot />
</Tag>
