---
interface Props {
  unit: string;
  label: string;
  status?: string;
  tone?: "amber" | "green" | "red";
}

const { unit, label, status, tone = "amber" } = Astro.props;
---

<section class={`magi magi-${tone}`} data-unit={unit}>
  <header class="magi-head">
    <span class="magi-unit">{unit}</span>
    <span class="magi-sep" aria-hidden="true">::</span>
    <span class="magi-label">{label}</span>
    {status && (
      <span class="magi-status">
        <span class="magi-dot" aria-hidden="true"></span>{status}
      </span>
    )}
  </header>
  <div class="magi-body">
    <slot />
  </div>
</section>

<style>
  .magi {
    border: 1px solid var(--border-subtle);
    background: var(--bg-panel);
    position: relative;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .magi:hover,
  .magi:focus-within {
    border-color: var(--accent-amber-soft);
  }

  .magi::before,
  .magi::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--accent-amber);
    pointer-events: none;
  }

  .magi::before {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .magi::after {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }

  .magi-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .magi-unit {
    color: var(--accent-amber);
    font-weight: 700;
  }

  .magi-sep {
    color: var(--border-strong);
  }

  .magi-label {
    color: var(--text-primary);
    flex: 1;
    min-width: 0;
  }

  .magi-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--magi-green);
    font-size: 0.85em;
  }

  .magi-dot {
    width: 6px;
    height: 6px;
    background: var(--magi-green);
    box-shadow: 0 0 6px var(--magi-green);
  }

  .magi-body {
    padding: var(--space-5);
  }

  .magi-green::before,
  .magi-green::after {
    border-color: var(--magi-green);
  }

  .magi-green .magi-unit {
    color: var(--magi-green);
  }

  .magi-red::before,
  .magi-red::after {
    border-color: var(--alarm-red);
  }

  .magi-red .magi-unit {
    color: var(--alarm-red);
  }

  @media (prefers-reduced-motion: reduce) {
    .magi {
      transition: none;
    }
  }
</style>
