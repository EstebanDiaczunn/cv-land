---
/**
 * HexGrid.astro
 * Source of truth: SPEC.md §6.4 + DESIGN_SYSTEM.md §4.2 (AT Field hexagonal).
 *
 * Decorative honeycomb background. Two stacked SVG data-URI tiles offset by
 * half a tile, which produces a real honeycomb tessellation (one hex per
 * tile, the second layer fills the gaps).
 *
 * - Fixed position, behind everything (z-index = --z-hex-grid = 0).
 * - aria-hidden="true", pointer-events: none.
 * - Opacity intentionally very low so it reads as ambient texture and never
 *   competes with text. SPEC §6.4: "AT Field hexagonal. Opacity bajísima.
 *   NO debe interferir con la legibilidad."
 * - Hidden when prefers-reduced-motion is set OR scan lines are active —
 *   keep the noise floor flat.
 *
 * Cost: ~280 bytes of inline SVG, 0 bytes of JS. Reused by every page via
 * BaseLayout.
 */
---

<div class="hex-grid" aria-hidden="true"></div>

<style>
  /* Single flat-topped hex outline as a 60x52 tile. Two layers, the second
   * offset by (30px, 26px) — that offset is exactly half the tile, which is
   * what produces the honeycomb interlock. Stroke color uses --border-subtle
   * tint of amber via the SVG `stroke` attribute. */
  .hex-grid {
    position: fixed;
    inset: 0;
    z-index: var(--z-hex-grid);
    pointer-events: none;
    opacity: 0.05;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='52' viewBox='0 0 60 52'><polygon points='30,1 58,15 58,37 30,51 2,37 2,15' fill='none' stroke='%23ff6600' stroke-width='1'/></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='52' viewBox='0 0 60 52'><polygon points='30,1 58,15 58,37 30,51 2,37 2,15' fill='none' stroke='%23ff6600' stroke-width='1'/></svg>");
    background-size: 60px 52px, 60px 52px;
    background-position: 0 0, 30px 26px;
    background-repeat: repeat, repeat;
    /* Mask so the field fades near the top/bottom edges — keeps the eye on
     * content and avoids the hex band aliasing with the StatusHeader border. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  /* When scan lines are on, the hex grid is hidden — two textured layers
   * compete and degrade legibility. */
  :global(html[data-scanlines="on"]) .hex-grid {
    display: none;
  }
</style>
