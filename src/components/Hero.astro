---
import Pill from './Pill.astro';
import { profile, ui, type Locale } from '../lib/i18n';

interface Props { locale: Locale; altPath: string }
const { locale, altPath } = Astro.props;
const t = ui[locale];
---
<header class="anim-fade-up flex items-start justify-between gap-6">
  <div class="min-w-0 flex-1">
    <h1 class="text-[22px] font-semibold tracking-tight text-[var(--color-text)]">
      {profile.name}
    </h1>
    <p class="mt-1 font-mono text-[13px] text-[var(--color-text-dim)]">
      {t.hero.role}
    </p>
    <p class="mt-0.5 flex items-center gap-1.5 font-mono text-[12px] text-[var(--color-text-muted)]">
      <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="8" cy="8" r="6.5" /><path d="M1.5 8h13M8 1.5c2 2 2 11 0 13M8 1.5c-2 2-2 11 0 13" />
      </svg>
      {t.hero.location}
    </p>

    <nav class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="contact">
      <a href={`mailto:${profile.email}`} aria-label={t.contact.email}
         class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-chip)] p-1.5 text-[var(--color-text-dim)] hover:bg-[var(--color-bg-chip-hover)] hover:opacity-100">
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><path d="m2 4 6 5 6-5"/></svg>
      </a>
      <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"
         class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-chip)] p-1.5 text-[var(--color-text-dim)] hover:bg-[var(--color-bg-chip-hover)] hover:opacity-100">
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor"><path d="M8 .2A8 8 0 0 0 5.5 15.8c.4.07.55-.17.55-.38v-1.34c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.74.54 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 .2Z"/></svg>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"
         class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-chip)] p-1.5 text-[var(--color-text-dim)] hover:bg-[var(--color-bg-chip-hover)] hover:opacity-100">
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor"><path d="M3.5 1.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM2 6h3v8H2V6Zm5 0h2.8v1.1c.4-.7 1.4-1.3 2.7-1.3 2.1 0 2.5 1.4 2.5 3.2V14h-3V9.4c0-1 0-2.2-1.4-2.2s-1.6 1-1.6 2.1V14H7V6Z"/></svg>
      </a>
      <a href={profile.cv} download
         class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-chip)] px-2 py-1 font-mono text-[11px] text-[var(--color-text-dim)] hover:bg-[var(--color-bg-chip-hover)] hover:opacity-100">
        {t.contact.cv}
      </a>
      <a href={altPath}
         class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-chip)] px-2 py-1 font-mono text-[11px] text-[var(--color-text-dim)] hover:bg-[var(--color-bg-chip-hover)] hover:opacity-100"
         aria-label="switch language">
        <span class="inline-flex items-center gap-1">
          <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 9 2 4 2-4M3 11h4M9 4h4M11 4v9M9 13c2-1 3-3 4-9"/></svg>
          {t.contact.lang}
        </span>
      </a>
    </nav>
  </div>

  <div class="shrink-0">
    <div class="relative">
      <div class="absolute inset-0 -m-1 rounded-full bg-gradient-to-br from-white/10 to-transparent blur-md"></div>
      <img src={profile.avatar} alt={profile.name}
           class="relative h-16 w-16 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg-elev)] object-cover" />
    </div>
  </div>
</header>
