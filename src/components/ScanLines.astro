---
/**
 * ScanLines.astro
 * Source of truth: SPEC.md §6.4 + DESIGN_SYSTEM.md §3.3 / §4.2.
 *
 * Optional CRT scan-line overlay. Off by default (per SPEC: "puede marear").
 * State lives on <html data-scanlines="on|off">, persisted in localStorage
 * as `cv-land:scanlines`. The toggle button is rendered separately in the
 * footer; this component owns:
 *   - the overlay element (fixed, pointer-events: none, full-viewport),
 *   - the inline script that hydrates state from storage AND wires the
 *     toggle button (#scanlines-toggle) so that clicking it flips the
 *     attribute and persists.
 *
 * Pure CSS overlay — no animation, no JS for the visual layer itself —
 * which means 0 perf cost when off, and only ~250 bytes of script for
 * the toggle plumbing.
 */
---

<div class="scanlines" aria-hidden="true"></div>

<script is:inline>
  (function () {
    var KEY = "cv-land:scanlines";
    var html = document.documentElement;

    function read() {
      try { return localStorage.getItem(KEY) === "on"; } catch (e) { return false; }
    }
    function write(on) {
      try { localStorage.setItem(KEY, on ? "on" : "off"); } catch (e) {}
    }
    function apply(on) {
      html.setAttribute("data-scanlines", on ? "on" : "off");
      var btn = document.getElementById("scanlines-toggle");
      if (btn) btn.setAttribute("aria-pressed", on ? "true" : "false");
    }

    // Hydrate from storage on first paint.
    apply(read());

    // Wire the footer toggle button. Idempotent — safe even if the button
    // mounts after this script (we re-query lazily on click via delegation).
    document.addEventListener("click", function (ev) {
      var target = ev.target;
      if (!target || !target.closest) return;
      var btn = target.closest("#scanlines-toggle");
      if (!btn) return;
      var next = html.getAttribute("data-scanlines") !== "on";
      apply(next);
      write(next);
    });
  })();
</script>

<style>
  .scanlines {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
    /* Off by default — only paint the gradient when html[data-scanlines="on"].
     * When off, this element is essentially free (no repaints, no compositing
     * cost beyond a position:fixed empty layer). */
    display: none;
    /* 3px-period horizontal stripes in --scan-overlay (rgba ámbar 0.03).
     * Subtle enough that it doesn't induce motion sickness for most users
     * but visible enough to register as "CRT". */
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      var(--scan-overlay) 2px,
      var(--scan-overlay) 3px
    );
    /* A second, very faint vignette so the screen feels curved. */
    box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.45);
  }

  :global(html[data-scanlines="on"]) .scanlines {
    display: block;
  }
</style>
