---
import { getCollection, getEntry, render } from "astro:content";
import MagiPanel from "./MagiPanel.astro";
import SyncBar from "./SyncBar.astro";
import { useTranslations, filterByLang, formatDateRange, type Lang } from "../lib/i18n.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const identityEntry = await getEntry("identity", "main");
if (!identityEntry) throw new Error("identity/main.yaml is missing");
const identity = identityEntry.data;

const skillsEntry = await getEntry("skills", "main");
if (!skillsEntry) throw new Error("skills/main.yaml is missing");
const skillsData = skillsEntry.data;

const educationEntry = await getEntry("education", "main");
if (!educationEntry) throw new Error("education/main.yaml is missing");
const educationData = educationEntry.data;

const experiences = filterByLang(await getCollection("experience"), lang).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = filterByLang(await getCollection("projects"), lang).sort(
  (a, b) => a.data.order - b.data.order,
);

const educationEntries = [...educationData.entries].sort(
  (a, b) => a.order - b.order,
);

const yearsLabel = lang === "es" ? "AÑOS" : "YRS";

function statusKey(status: string): string {
  return `status.${status.toLowerCase()}`;
}
---

<main class="page">
  <!-- HERO / OPERATIVE PROFILE -->
  <section class="hero" aria-labelledby="operative-name">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <span class="hero-bracket" aria-hidden="true">[</span>
        <span>{t("section.about")}</span>
        <span class="hero-bracket" aria-hidden="true">]</span>
      </p>

      <h1 id="operative-name" class="hero-name">
        {identity.realName.toUpperCase()}
      </h1>

      <p class="hero-codename">
        <span class="hero-codename-label">{t("hero.codename")}</span>
        <span class="hero-codename-sep" aria-hidden="true">::</span>
        <span class="hero-codename-value">{identity.codename}</span>
      </p>

      <p class="hero-title">
        {identity.title[lang]}
      </p>

      <dl class="hero-meta">
        <div class="hero-meta-row">
          <dt>{t("badge.status")}</dt>
          <dd class="meta-active">
            <span class="meta-dot" aria-hidden="true"></span>
            {t(statusKey(identity.status))}
          </dd>
        </div>
        <div class="hero-meta-row">
          <dt>{t("badge.clearance")}</dt>
          <dd>TIER {identity.clearance}</dd>
        </div>
        <div class="hero-meta-row">
          <dt>{t("badge.location")}</dt>
          <dd>{identity.location.toUpperCase()}</dd>
        </div>
      </dl>

      <p class="hero-summary">{identity.summary[lang]}</p>
    </div>
  </section>

  <!-- EXPERIENCE / OPERATIONAL TENURE -->
  <section class="block" id="experience" aria-labelledby="experience-title">
    <header class="block-head">
      <span class="block-eyebrow">// 02</span>
      <h2 id="experience-title" class="block-title">{t("section.experience")}</h2>
    </header>

    <div class="block-body experience-list">
      {experiences.map(async (entry, idx) => {
        const { Content } = await render(entry);
        const e = entry.data;
        const unit = `MAGI-${String(idx + 1).padStart(2, "0")}`;
        return (
          <MagiPanel
            unit={unit}
            label={e.codename}
            status={e.current ? t("badge.current") : undefined}
            tone={e.current ? "amber" : "amber"}
          >
            <div class="exp">
              <div class="exp-grid">
                <dl class="exp-meta">
                  <div>
                    <dt>{t("badge.role")}</dt>
                    <dd>{e.role[lang]}</dd>
                  </div>
                  <div>
                    <dt>{t("badge.facility")}</dt>
                    <dd>{e.realCompany}</dd>
                  </div>
                  <div>
                    <dt>{t("badge.tenure")}</dt>
                    <dd class="exp-mono">{formatDateRange(e.startDate, e.endDate, lang)}</dd>
                  </div>
                  <div>
                    <dt>{t("badge.location")}</dt>
                    <dd>{e.location}</dd>
                  </div>
                </dl>
              </div>

              <div class="exp-prose">
                <Content />
              </div>

              <ul class="exp-stack" aria-label={t("badge.stack")}>
                {e.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          </MagiPanel>
        );
      })}
    </div>
  </section>

  <!-- PROJECTS / MISSION LOG -->
  <section class="block" id="projects" aria-labelledby="projects-title">
    <header class="block-head">
      <span class="block-eyebrow">// 03</span>
      <h2 id="projects-title" class="block-title">{t("section.projects")}</h2>
    </header>

    <div class="block-body project-list">
      {projects.map((entry) => {
        const p = entry.data;
        return (
          <article class="project">
            <header class="project-head">
              <span class="project-unit">{p.codename}</span>
              <span class="project-status" data-status={p.status}>
                <span class="meta-dot" aria-hidden="true"></span>
                {t(statusKey(p.status))}
              </span>
            </header>
            <p class="project-synopsis">{p.synopsis[lang]}</p>
            <ul class="exp-stack" aria-label={t("badge.stack")}>
              {p.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
  </section>

  <!-- SKILLS / SYNCHRONIZATION RATES -->
  <section class="block" id="skills" aria-labelledby="skills-title">
    <header class="block-head">
      <span class="block-eyebrow">// 04</span>
      <h2 id="skills-title" class="block-title">{t("section.skills")}</h2>
    </header>

    {skillsData.pendingOwnerReview && (
      <p class="block-note">{t("skill.pendingReview")}</p>
    )}

    <div class="block-body skills-grid">
      {skillsData.categories.map((cat, idx) => {
        const unit = `SYNC-${String(idx + 1).padStart(2, "0")}`;
        return (
          <MagiPanel unit={unit} label={cat.label[lang]}>
            <ul class="sync-list">
              {cat.items.map((item) => (
                <li>
                  <SyncBar
                    name={item.name}
                    syncRate={item.syncRate}
                    years={item.years}
                    yearsLabel={yearsLabel}
                  />
                </li>
              ))}
            </ul>
          </MagiPanel>
        );
      })}
    </div>
  </section>

  <!-- EDUCATION / TRAINING DOSSIER -->
  <section class="block" id="education" aria-labelledby="education-title">
    <header class="block-head">
      <span class="block-eyebrow">// 05</span>
      <h2 id="education-title" class="block-title">{t("section.education")}</h2>
    </header>

    <div class="block-body education-list">
      {educationEntries.map((entry) => (
        <article class="edu">
          <header class="edu-head">
            <span class="edu-codename">{entry.codename}</span>
            <span class="edu-status" data-status={entry.status}>
              {t(statusKey(entry.status))}
            </span>
          </header>
          <h3 class="edu-degree">{entry.degree[lang]}</h3>
          <p class="edu-institution">{entry.institution}</p>
          <dl class="edu-meta">
            <div>
              <dt>{t(`education.kind.${entry.kind.toLowerCase()}`)}</dt>
              <dd class="exp-mono">
                {entry.startDate}
                {entry.endDate ? ` → ${entry.endDate}` : entry.status === "IN_PROGRESS" ? ` → ${t("common.present")}` : ""}
              </dd>
            </div>
            {entry.field && (
              <div>
                <dt>{t("badge.note")}</dt>
                <dd>{entry.field[lang]}</dd>
              </div>
            )}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <!-- CONTACT / SECURE CHANNEL -->
  <section class="block" id="contact" aria-labelledby="contact-title">
    <header class="block-head">
      <span class="block-eyebrow">// 06</span>
      <h2 id="contact-title" class="block-title">{t("section.contact")}</h2>
    </header>

    <div class="block-body">
      <MagiPanel unit="CHANNEL-01" label={t("contact.directLine")} tone="green" status={t("status.active")}>
        <ul class="channel-list">
          <li>
            <span class="channel-label">{t("contact.email")}</span>
            <a class="channel-value" href={`mailto:${identity.channels.email}`}>
              {identity.channels.email}
            </a>
          </li>
          <li>
            <span class="channel-label">{t("section.languages")}</span>
            <span class="channel-value">
              {identity.languages.map((l, i) => (
                <>
                  {i > 0 && <span class="channel-sep" aria-hidden="true"> · </span>}
                  <span>{l.code.toUpperCase()} ({l.label[lang].toUpperCase()})</span>
                </>
              ))}
            </span>
          </li>
        </ul>
      </MagiPanel>
    </div>
  </section>
</main>

<style>
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-12), 8vh, var(--space-20));
    padding: clamp(var(--space-10), 8vh, var(--space-16))
      clamp(var(--space-4), 4vw, var(--space-12));
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
  }

  /* HERO */
  .hero {
    animation: nerv-fade-in 600ms var(--ease-out) both;
  }

  .hero-inner {
    width: 100%;
    max-width: 1024px;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    display: inline-flex;
    gap: var(--space-2);
  }

  .hero-bracket {
    color: var(--border-strong);
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .hero-codename {
    margin: var(--space-3) 0 0;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-h4);
    color: var(--text-amber);
    text-transform: uppercase;
    animation: nerv-hero-track-in 700ms var(--ease-out) 200ms both;
  }

  .hero-codename-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
  }

  .hero-codename-sep {
    color: var(--accent-amber);
    font-weight: 700;
  }

  .hero-codename-value {
    color: var(--accent-amber);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .hero-title {
    margin: var(--space-8) 0 0;
    max-width: 60ch;
    font-family: var(--font-sans);
    font-size: var(--text-h5);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .hero-meta {
    margin: var(--space-10) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    max-width: 480px;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }

  .hero-meta-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-meta dt {
    color: var(--text-muted);
  }

  .hero-meta dd {
    margin: 0;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .meta-active {
    color: var(--magi-green) !important;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    background: var(--magi-green);
    box-shadow: 0 0 6px var(--magi-green);
  }

  .hero-summary {
    margin: var(--space-10) 0 0;
    max-width: 70ch;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    border-left: 2px solid var(--accent-amber);
    padding-left: var(--space-5);
  }

  /* BLOCK / SECTION */
  .block {
    display: grid;
    gap: var(--space-6);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-3);
  }

  .block-eyebrow {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
  }

  .block-title {
    margin: 0;
    color: var(--accent-amber);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .block-note {
    margin: 0;
    color: var(--text-amber);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px dashed var(--accent-amber-soft);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 102, 0, 0.04);
  }

  /* EXPERIENCE */
  .experience-list {
    display: grid;
    gap: var(--space-6);
  }

  .exp {
    display: grid;
    gap: var(--space-5);
  }

  .exp-grid {
    display: grid;
    gap: var(--space-3);
  }

  .exp-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-6);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exp-meta div {
    display: grid;
    gap: var(--space-1);
  }

  .exp-meta dt {
    color: var(--text-muted);
  }

  .exp-meta dd {
    margin: 0;
    color: var(--text-primary);
  }

  .exp-mono {
    font-feature-settings: "tnum";
  }

  .exp-prose {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  .exp-prose :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .exp-prose :global(li) {
    position: relative;
    padding-left: var(--space-5);
  }

  .exp-prose :global(li)::before {
    content: ">";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .exp-prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .exp-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .exp-stack li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--text-amber);
    text-transform: uppercase;
  }

  /* PROJECTS */
  .project-list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .project {
    border: 1px solid var(--border-subtle);
    background: var(--bg-panel);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .project-unit {
    color: var(--accent-amber);
    font-weight: 700;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--magi-green);
  }

  .project-synopsis {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  /* SKILLS */
  .skills-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sync-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  /* EDUCATION */
  .education-list {
    display: grid;
    gap: var(--space-4);
  }

  .edu {
    border: 1px solid var(--border-subtle);
    background: var(--bg-panel);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .edu-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .edu-codename {
    color: var(--accent-amber);
  }

  .edu-status {
    color: var(--text-amber);
  }

  .edu-status[data-status="COMPLETED"] {
    color: var(--magi-green);
  }

  .edu-degree {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .edu-institution {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
  }

  .edu-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .edu-meta div {
    display: grid;
    gap: var(--space-1);
  }

  .edu-meta dt {
    color: var(--text-muted);
  }

  .edu-meta dd {
    margin: 0;
    color: var(--text-primary);
  }

  /* CONTACT */
  .channel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .channel-list li {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .channel-label {
    color: var(--text-muted);
  }

  .channel-value {
    color: var(--text-primary);
  }

  a.channel-value {
    color: var(--accent-amber);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms var(--ease-out);
  }

  a.channel-value:hover,
  a.channel-value:focus-visible {
    border-color: var(--accent-amber);
  }

  @media (max-width: 540px) {
    .exp-meta {
      grid-template-columns: 1fr;
    }
    .channel-list li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .edu-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
