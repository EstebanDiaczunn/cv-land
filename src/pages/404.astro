---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BASE } from "../lib/paths.ts";

// 404 is built once into dist/404.html and served by nginx for any unmatched
// route (Fase 5 wires `error_page 404 /404.html;`). Because it's a single file,
// we can't pick the lang at build time — we render both ES and EN messages in
// the DOM and let an inline script flip a data attribute based on pathname.
// Chrome (StatusHeader / SiteFooter) stays in ES; not worth swapping for an
// error page. showBoot=false: the boot overlay would be obnoxious on a 404.
---

<BaseLayout
  lang="es"
  showBoot={false}
  title="SIGNAL LOST — 404 — NAIKI"
  description="La ruta solicitada no existe en la base de datos de NERV."
>
  <main class="signal-lost" data-active-lang="es">
    <div class="frame">
      <header class="frame-head">
        <span class="frame-eyebrow">// NERV SYSTEMS</span>
        <span class="frame-code">ERROR CODE: 404</span>
      </header>

      <h1 class="title">SIGNAL LOST</h1>

      <p class="msg" data-lang="es">
        La ruta solicitada no existe en la base de datos de NERV.
        La transmisión se ha perdido o el segmento ha sido clasificado.
      </p>
      <p class="msg" data-lang="en">
        The requested route is not present in NERV's database.
        Transmission lost or segment classified.
      </p>

      <div class="actions">
        <a class="back-btn" href="/" data-back>
          <span class="back-arrow" aria-hidden="true">&laquo;</span>
          <span class="back-label" data-lang="es">VOLVER AL INICIO</span>
          <span class="back-label" data-lang="en">RETURN TO BASE</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ BASE }}>
  // Lang detection by pathname. Inline so it runs before paint y evita
  // un flash del idioma equivocado. BASE (/, /cv-land/, etc.) se inyecta
  // a build time via define:vars para que el regex y el back href
  // funcionen con o sin base path. CSP note Fase 5: al agregar script-src
  // estricto, hashear este bloque (SHA-256) y meter el hash en la policy.
  (function () {
    var path = location.pathname;
    var rel = path.indexOf(BASE) === 0 ? "/" + path.slice(BASE.length) : path;
    var isEn = /^\/en(\/|$)/.test(rel);
    var lang = isEn ? "en" : "es";
    document.documentElement.lang = lang;
    var main = document.querySelector(".signal-lost");
    if (main) main.setAttribute("data-active-lang", lang);
    var back = document.querySelector("[data-back]");
    if (back) back.setAttribute("href", isEn ? BASE + "en/" : BASE);
  })();
</script>

<style>
  .signal-lost {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(var(--space-10), 10vh, var(--space-20))
      clamp(var(--space-4), 4vw, var(--space-12));
  }

  .frame {
    width: 100%;
    max-width: 640px;
    border: 1px solid var(--border-strong);
    background: var(--bg-panel);
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    display: grid;
    gap: var(--space-6);
    animation: nerv-fade-in 400ms var(--ease-out) both;
  }

  .frame-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .frame-eyebrow {
    color: var(--text-muted);
  }

  .frame-code {
    color: var(--alarm-red);
    font-weight: 700;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--alarm-red);
    text-shadow: 0 0 16px rgba(214, 33, 33, 0.35);
  }

  .msg {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
  }

  /* Pre-paint: ES is shown by default to avoid FOUC if the inline script
   * is delayed by anything weird. EN gets unhidden when data-active-lang flips. */
  [data-active-lang="es"] [data-lang="en"],
  [data-active-lang="en"] [data-lang="es"] {
    display: none;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-5);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--accent-amber);
    background: transparent;
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .back-btn:hover,
  .back-btn:focus-visible {
    background: var(--accent-amber);
    color: var(--bg-void);
    transform: translateY(-1px);
  }

  .back-arrow {
    color: inherit;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame {
      animation: none;
    }
    .back-btn {
      transition: none;
    }
    .back-btn:hover,
    .back-btn:focus-visible {
      transform: none;
    }
  }
</style>
