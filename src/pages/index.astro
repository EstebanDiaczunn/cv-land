---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Pill from '../components/Pill.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ui, profile } from '../lib/i18n';

const locale = 'es' as const;
const t = ui[locale];

const aboutEntry = await getEntry('about', 'es');
const { Content: AboutContent } = await render(aboutEntry!);

const experiences = (await getCollection('experience', (e) => e.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);

const educations = (await getCollection('education', (e) => e.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);

const skills = await getEntry('skills', 'es');
const languages = await getEntry('languages', 'es');
---
<BaseLayout
  title={`${profile.name} — ${t.hero.role}`}
  description="CV de Esteban Nicolás Diaczun, Backend Developer."
  locale={locale}
>
  <Hero locale={locale} altPath="/en" />

  <hr />

  <Section id="about" title={t.sections.about} delay={60}>
    <AboutContent />
  </Section>

  <hr />

  <Section id="experience" title={t.sections.experience} delay={120}>
    <div class="space-y-2">
      {experiences.map(async (e) => {
        const { Content } = await render(e);
        return (
          <ExperienceEntry
            locale={locale}
            company={e.data.company}
            role={e.data.role}
            remote={e.data.remote}
            start={e.data.start}
            end={e.data.end}
            stack={e.data.stack}
          >
            <Content />
          </ExperienceEntry>
        );
      })}
    </div>
  </Section>

  <hr />

  <Section id="education" title={t.sections.education} delay={180}>
    <ul class="space-y-3">
      {educations.map(async (ed) => {
        const { Content } = await render(ed);
        return (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="text-[14px] font-semibold text-[var(--color-text)]">{ed.data.institution}</h3>
              <span class="font-mono text-[11px] text-[var(--color-text-muted)]">{ed.data.period}</span>
            </div>
            <p class="font-mono text-[12px] text-[var(--color-text-dim)]">{ed.data.program}</p>
            <div class="mt-1 font-mono-tight text-[var(--color-text-dim)]"><Content /></div>
          </li>
        );
      })}
    </ul>
  </Section>

  <hr />

  <Section id="skills" title={t.sections.skills} delay={240}>
    <div class="space-y-3">
      {skills!.data.groups.map((g) => (
        <div>
          <p class="mb-1.5 font-mono text-[11px] uppercase tracking-wider text-[var(--color-text-muted)]">{g.title}</p>
          <div class="flex flex-wrap gap-1">
            {g.items.map((s) => <Pill>{s}</Pill>)}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <hr />

  <Section id="languages" title={t.sections.languages} delay={300}>
    <div class="flex flex-wrap gap-1.5">
      {languages!.data.items.map((l) => (
        <Pill>
          <span class="text-[var(--color-text)]">{l.name}</span>
          <span class="text-[var(--color-text-muted)]">·</span>
          <span>{l.level}</span>
        </Pill>
      ))}
    </div>
  </Section>

  <footer class="mt-16 flex items-center justify-between font-mono text-[11px] text-[var(--color-text-muted)]">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
  </footer>

  <CommandPalette locale={locale} altPath="/en" />
</BaseLayout>
