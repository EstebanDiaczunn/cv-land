---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="hero">
    <section class="hero-inner" aria-labelledby="operative-name">
      <p class="hero-eyebrow">
        <span class="hero-bracket" aria-hidden="true">[</span>
        <span>OPERATIVE PROFILE</span>
        <span class="hero-bracket" aria-hidden="true">]</span>
      </p>

      <h1 id="operative-name" class="hero-name">ESTEBAN DIACZUNN</h1>

      <p class="hero-codename">
        <span class="hero-codename-label">CODENAME</span>
        <span class="hero-codename-sep" aria-hidden="true">::</span>
        <span class="hero-codename-value">NAIKI</span>
      </p>

      <p class="hero-title">
        <span lang="es">Desarrollador Backend / Aspirante a Arquitecto de Software</span>
        <span class="hero-title-sep" aria-hidden="true">/</span>
        <span lang="en">Backend Developer / Software Architect-in-training</span>
      </p>

      <dl class="hero-meta">
        <div class="hero-meta-row">
          <dt>STATUS</dt>
          <dd class="meta-active">
            <span class="meta-dot" aria-hidden="true"></span>ACTIVE
          </dd>
        </div>
        <div class="hero-meta-row">
          <dt>CLEARANCE</dt>
          <dd>TIER 3</dd>
        </div>
        <div class="hero-meta-row">
          <dt>LOCATION</dt>
          <dd>BERAZATEGUI · BUENOS AIRES · AR</dd>
        </div>
      </dl>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(var(--space-12), 10vh, var(--space-24))
      clamp(var(--space-4), 4vw, var(--space-12));
  }

  .hero-inner {
    width: 100%;
    max-width: 1024px;
    animation: nerv-fade-in 600ms var(--ease-out) both;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    display: inline-flex;
    gap: var(--space-2);
  }

  .hero-bracket {
    color: var(--border-strong);
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .hero-codename {
    margin: var(--space-3) 0 0;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-h4);
    color: var(--text-amber);
    text-transform: uppercase;
    animation: nerv-hero-track-in 700ms var(--ease-out) 200ms both;
  }

  .hero-codename-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
  }

  .hero-codename-sep {
    color: var(--accent-amber);
    font-weight: 700;
  }

  .hero-codename-value {
    color: var(--accent-amber);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .hero-title {
    margin: var(--space-8) 0 0;
    max-width: 60ch;
    font-family: var(--font-sans);
    font-size: var(--text-h5);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
  }

  .hero-title-sep {
    color: var(--border-strong);
    font-family: var(--font-mono);
  }

  .hero-meta {
    margin: var(--space-10) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    max-width: 480px;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }

  .hero-meta-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-meta dt {
    color: var(--text-muted);
  }

  .hero-meta dd {
    margin: 0;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .meta-active {
    color: var(--magi-green) !important;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    background: var(--magi-green);
    box-shadow: 0 0 6px var(--magi-green);
  }

  @media (max-width: 480px) {
    .hero-meta-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
